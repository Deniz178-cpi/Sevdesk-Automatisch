# sevDesk: Einstellungen -> Benutzer -> API-Token
SEVDESK_API_TOKEN=
# Anthropic: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Passwort für die Web-App (mindestens 16 Zeichen). Ohne Passwort bleibt die App gesperrt.
APP_PASSWORD=
# Steuerregel: 1 = Umsatzsteuerpflichtige Umsätze (Regelbesteuerung)
SEVDESK_TAX_RULE=1
