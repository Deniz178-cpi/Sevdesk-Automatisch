# sevDesk: Einstellungen -> Benutzer -> API-Token
SEVDESK_API_TOKEN=
# Passwort für die App (mindestens 16 Zeichen). Ohne Passwort bleibt die App gesperrt.
APP_PASSWORD=

# KI: "ollama" = lokal und kostenlos (Standard), "claude" = Anthropic-API (kostet ca. 1-2 Cent pro Rechnung)
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
# Nur bei AI_PROVIDER=claude nötig:
ANTHROPIC_API_KEY=

# 1 = nur Geräte aus dem eigenen WLAN/LAN dürfen zugreifen
LAN_ONLY=1
# Steuerregel: 1 = Umsatzsteuerpflichtige Umsätze (Regelbesteuerung)
SEVDESK_TAX_RULE=1
